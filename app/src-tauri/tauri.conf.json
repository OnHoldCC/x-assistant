{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnHold Admin",
  "version": "0.9.1",
  "identifier": "cc.onhold.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OnHold 运营后台",
        "width": 1320,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* https:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/": "web/",
      "../../extension/": "extension/"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
