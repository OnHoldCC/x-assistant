{
  "manifest_version": 3,
  "name": "OnHold 助手",
  "version": "1.4.4",
  "minimum_chrome_version": "120",
  "description": "X 账号分析、创作者进度、收藏标签与自动化助手。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1:18427/*",
    "http://127.0.0.1:18431/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OnHold 助手",
    "default_popup": "admin-ui/bridge.html",
    "default_icon": {
      "16": "assets/assistant-16.png",
      "32": "assets/assistant-32.png"
    }
  },
  "options_page": "settings.html",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "metrics-core.js",
        "x-dashboard.js",
        "ad-filter.js",
        "translation-ui.js",
        "x-reading-source.js",
        "content.js",
        "onhold-ui.js",
        "compose.js",
        "post-border.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/assistant-16.png",
    "32": "assets/assistant-32.png",
    "48": "assets/assistant-48.png",
    "128": "assets/assistant-128.png"
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/nunito-variable.ttf"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
