{
  "name": "onhold-assistant",
  "version": "0.8.0",
  "description": "OnHold Vue 3 / Soybean Admin frontend, Rust data backend and CDP browser companion.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "onhold-assistant": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "extension",
    "skills",
    "docs",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "installer:sync": "node scripts/sync-installer.mjs",
    "installer:check": "node scripts/sync-installer.mjs --check",
    "docker:pack": "node scripts/package-docker.mjs",
    "app:build": "npm --prefix app run build",
    "desktop:start": "npm --prefix app run tauri -- dev",
    "desktop:pack": "node app/scripts/build-desktop.mjs",
    "desktop:installer": "node app/scripts/build-macos-installer.mjs",
    "android:init": "npm --prefix app run android -- init",
    "android:pack": "npm --prefix app run android -- build --apk",
    "ios:init": "npm --prefix app run ios -- init",
    "ios:pack": "npm --prefix app run ios -- build",
    "backend:test": "cargo test --manifest-path backend/Cargo.toml",
    "backend:start": "cargo run --manifest-path backend/Cargo.toml --",
    "ui:dev": "npm --prefix app run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnHoldCC/x-assistant.git"
  }
}
