{
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","analysis","text"],
  "properties":{
    "schema_version":{"type":"integer","enum":[1]},
    "analysis":{
      "type":"object",
      "additionalProperties":false,
      "required":["topic","structure","tone","key_points"],
      "properties":{
        "topic":{"type":"string","minLength":1,"maxLength":200},
        "structure":{"type":"string","minLength":1,"maxLength":1000},
        "tone":{"type":"string","minLength":1,"maxLength":200},
        "key_points":{"type":"array","minItems":1,"maxItems":6,"items":{"type":"string","minLength":1,"maxLength":500}}
      }
    },
    "text":{"type":"string","minLength":1,"maxLength":24000}
  }
}
