FROM node:24.14.1-bookworm-slim@sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c AS gateway
WORKDIR /opt/onhold
RUN mkdir -p /models /data/gateway /secrets && chown -R 1000:1000 /models /data /secrets
COPY lib/ lib/
COPY extension/languages.json extension/analysis-core.js extension/
COPY docker/ docker/
COPY LICENSE THIRD_PARTY_NOTICES.txt ./
USER 1000:1000
CMD ["node", "docker/gateway.mjs"]

FROM gateway AS agent
USER root
RUN npm install --global --registry=https://registry.npmjs.org @openai/codex@0.165.0 && npm cache clean --force
USER 1000:1000
ENV CODEX_HOME=/data/codex HOME=/data
CMD ["node", "docker/codex.mjs"]
