{
  "manifest_version": 3,
  "name": "OnHold 助手",
  "version": "1.2.15",
  "minimum_chrome_version": "120",
  "description": "X 一键翻译与撤销，浏览帖子上沿展示参考评分与互动数据，使用 OnHold 字体。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1:18427/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OnHold 助手",
    "default_popup": "settings.html",
    "default_icon": {
      "16": "assets/assistant-16.png",
      "32": "assets/assistant-32.png"
    }
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "metrics-core.js",
        "x-dashboard.js",
        "ad-filter.js",
        "translation-ui.js",
        "x-reading-source.js",
        "content.js",
        "onhold-ui.js",
        "compose.js",
        "post-border.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/assistant-16.png",
    "32": "assets/assistant-32.png",
    "48": "assets/assistant-48.png",
    "128": "assets/assistant-128.png"
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/nunito-variable.ttf"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
