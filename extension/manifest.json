{
  "manifest_version": 3,
  "name": "OnHold 助手",
  "version": "1.0.1",
  "minimum_chrome_version": "120",
  "description": "本机多语言互译、X 草稿预览、推文标签复制与参考评分，以及模型资源状态。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1:18427/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OnHold 助手",
    "default_popup": "settings.html",
    "default_icon": {
      "16": "assets/assistant-16.png",
      "32": "assets/assistant-32.png"
    }
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "translation-ui.js",
        "content.js",
        "compose.js",
        "metrics-core.js",
        "analysis-core.js",
        "post-analysis.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/assistant-16.png",
    "32": "assets/assistant-32.png",
    "48": "assets/assistant-48.png",
    "128": "assets/assistant-128.png"
  },
  "key": ""
}
